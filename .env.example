# ============================================================================
# LTT BD V4 — ENVIRONMENT CONFIGURATION TEMPLATE
# Supports both new Supabase keys (sb_publishable_ / sb_secret_) and legacy keys.
# ============================================================================

# 1. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Key (use Publishable Key or Legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Supabase Server-Only Secret Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Server-Side Cryptographic Secrets (64-char random hex strings)
LTTBD_ROSTER_PEPPER=
LTTBD_SESSION_SECRET=

# 5. Local-Only Admin Fallback (used only when Supabase is not configured)
LTTBD_DEFAULT_ADMIN_EMAIL=
LTTBD_DEFAULT_ADMIN_PASSWORD=

# 6. Free Street Map Tiles (Esri World Street Map — No API key required)
NEXT_PUBLIC_MAP_TILE_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
NEXT_PUBLIC_MAP_ATTRIBUTION="Tiles &copy; Esri"

# 7. Free-Tier GPS Intervals (45s updates, 240s stale threshold)
NEXT_PUBLIC_GPS_INTERVAL_SECONDS=45
NEXT_PUBLIC_STALE_LOCATION_SECONDS=240
