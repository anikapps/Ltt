# ============================================================================
# LTT BD — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your values.
# Leave NEXT_PUBLIC_SUPABASE_URL blank to run in Offline Local Evaluation Mode,
# or fill in your Supabase credentials for full cloud PostgreSQL + Realtime.
# ============================================================================

# 1. Supabase Public Configuration (Safe for Browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Supabase Server-Only Secret Key (NEVER expose in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Server-Side Cryptographic Secrets for Roster HMAC & Tourist Session Signing
LTTBD_ROSTER_PEPPER=
LTTBD_SESSION_SECRET=

# 4. Admin Bootstrap Credentials (generated automatically for local setup)
# For production, set your own strong values. Keep them server-only; never commit secrets.
LTTBD_DEFAULT_ADMIN_EMAIL=
LTTBD_DEFAULT_ADMIN_PASSWORD=

# 5. Map Tile Provider (CARTO Voyager — No API key required)
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# 6. GPS Tracking & Stale Thresholds (in seconds)
NEXT_PUBLIC_GPS_INTERVAL_SECONDS=20
NEXT_PUBLIC_STALE_LOCATION_SECONDS=180
