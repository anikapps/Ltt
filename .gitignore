# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/build

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Local runtime data & diagnostics (NEVER commit passenger data or machine logs)
/data/
/lttbd-startup.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript & test artifacts
*.tsbuildinfo
next-env.d.ts
/coverage

# OS & editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Certificates, deployment metadata & archive backups
*.pem
.vercel
*.zip
