# Normalize line endings across Windows, macOS, and Linux
* text=auto eol=lf

# Windows batch and PowerShell scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.zip binary
