{
  "name": "ltt-bd-live",
  "version": "3.1.0",
  "private": true,
  "description": "LTT BD — Progressive Web Application for group travel coordination and live tourist location sharing",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "setup:local": "node scripts/bootstrap-local-env.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:security": "node scripts/run-verification-tests.mjs",
